# ─────────────────────────────────────────────────────────────
# EasySeva — environment variables
# Copy this file to `.env` and fill in the values.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required).
# Local example: postgresql://postgres:password@localhost:5432/easyseva
# Hosted (Neon/Supabase/Render) example: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/easyseva"

# Secret used to sign session JWTs (required). Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-secret"

# Stripe keys — optional. Payment runs in demo mode if left as dummy values.
STRIPE_SECRET_KEY="sk_test_dummy_key_for_easyseva_demo"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_dummy_key_for_easyseva_demo"

# Email / SMTP — optional. If unset, OTP codes are shown on screen (demo mode).
EMAIL_FROM="noreply@easyseva.gov.in"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Public base URL of the app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
